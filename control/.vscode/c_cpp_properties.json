{
    "configurations": [
        {
            "name": "AVR",
            "compilerPath": "/usr/bin/avr-gcc",
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "/workspace/**",
                "/usr/lib/avr/include",
                "/usr/lib/avr/include/avr/*",
                "/usr/lib/gcc/avr/**"
            ],
            "defines": [
                "F_CPU=16000000UL",
                "__AVR_ATmega8__",
                "MCU=atmega8"
            ],
            "mergeConfigurations": false,
            "recursiveIncludes": {},
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "AVR_inte",
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ],
            "intelliSenseMode": "gcc-x64",
            "mergeConfigurations": false,
            "recursiveIncludes": {},
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            },
            "cStandard": "c11"
        }
    ],
    "version": 4
}